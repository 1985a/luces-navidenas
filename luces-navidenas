def _write_wav(path, samples, rate):
    """Normaliza y guarda en WAV de 16 bits. Escribe a un temporal y lo renombra: quien
    lo lea (la música arranca mientras esto aún corre) nunca ve un archivo a medias."""
    peak = max(1e-6, *(abs(s) for s in samples))
    norm = 0.85 / peak
    data = struct.pack(f"<{len(samples)}h", *(int(max(-1, min(1, s * norm)) * 32767) for s in samples))
    tmp = path + ".tmp"
    with wave.open(tmp, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(rate)
        w.writeframes(data)
    os.replace(tmp, path)


def _bell(buf, rate, start, freq, dur, amp, decay=3.2, partials=((1, 1), (2, 0.45), (3, 0.2), (4.2, 0.12))):
    n0 = int(start * rate)
    n = int(dur * rate)
    two_pi = 2 * math.pi
    for k in range(n):
        i = n0 + k
        if i >= len(buf):
            break
        tt = k / rate
        env = math.exp(-tt * decay) * min(1.0, tt / 0.004)
        s = 0.0
        for mult, a in partials:
            s += a * math.sin(two_pi * freq * mult * tt) * math.exp(-tt * decay * (mult - 1) * 0.6)
        buf[i] += amp * env * s


SOUNDS_READY = threading.Event()  # se marca cuando generate_sounds() terminó (bien o mal)


def generate_sounds():
    """Sintetiza el villancico y los efectos la primera vez (≈4 s de CPU) y los deja en caché."""
    try:
        _generate_sounds()
    except OSError as e:
        print(f"Luces Navideñas: no se pudieron crear los sonidos: {e}", file=sys.stderr)
    finally:
        SOUNDS_READY.set()


def _generate_sounds():
    os.makedirs(CACHE_DIR, exist_ok=True)
    rate = 22050
    song = os.path.join(CACHE_DIR, "jingle-bells.wav")
    if not os.path.exists(song):
        N = {"C": 523.25, "D": 587.33, "E": 659.25, "F": 698.46, "G": 783.99}
        mel = ("E1 E1 E2 E1 E1 E2 E1 G1 C1.5 D.5 E4 F1 F1 F1.5 F.5 F1 E1 E1 E.5 E.5 E1 D1 D1 E1 D2 G2 "  # noqa: SIM905
               "E1 E1 E2 E1 E1 E2 E1 G1 C1.5 D.5 E4 F1 F1 F1.5 F.5 F1 E1 E1 E.5 E.5 G1 G1 F1 D1 C4").split()
        bass = [130.81, 130.81, 130.81, 130.81, 174.61, 130.81, 146.83, 196.0,
                130.81, 130.81, 130.81, 130.81, 174.61, 130.81, 196.0, 130.81]
        beat = 0.30
        total = 64 * beat + 2.0
        buf = [0.0] * int(total * rate)
        t = 0.2
        for tok in mel:
            note, d = tok[0], float(tok[1:])
            _bell(buf, rate, t, N[note], 1.3, 0.55)
            t += d * beat
        for m, f in enumerate(bass):
            for b in (0, 2):
                _bell(buf, rate, 0.2 + (m * 4 + b) * beat, f, 0.9, 0.28, decay=4.5,
                      partials=((1, 1), (2, 0.3)))
        _write_wav(song, buf, rate)
    tick = os.path.join(CACHE_DIR, "tic.wav")
    if not os.path.exists(tick):
        buf = [0.0] * int(0.06 * rate)
        _bell(buf, rate, 0, 2600, 0.06, 0.4, decay=70, partials=((1, 1), (1.5, 0.5)))
        _write_wav(tick, buf, rate)
    for name, notes in (("encender.wav", (1046.5, 1568.0)), ("apagar.wav", (1568.0, 1046.5))):
        p = os.path.join(CACHE_DIR, name)
        if not os.path.exists(p):
            buf = [0.0] * int(0.9 * rate)
            _bell(buf, rate, 0.0, notes[0], 0.6, 0.5, decay=6)
            _bell(buf, rate, 0.12, notes[1], 0.75, 0.5, decay=5)
            _write_wav(p, buf, rate)


def _which(*names):
    for n in names:
        if shutil.which(n):
            return n
    return None


def wav_command(path, vol=1.0):
    p = _which("pw-play", "paplay", "ffplay", "mpv", "aplay")
    if p == "pw-play":
        return ["pw-play", f"--volume={vol:.3f}", path]
    if p == "paplay":
        return ["paplay", f"--volume={int(vol * 65536)}", path]
    if p == "ffplay":
        return ["ffplay", "-nodisp", "-autoexit", "-loglevel", "quiet", "-volume", str(int(vol * 100)), path]
    if p == "mpv":
        return ["mpv", "--no-video", "--really-quiet", f"--volume={int(vol * 100)}", path]
    if p == "aplay":
        return ["aplay", "-q", path]
    return None


def _soundfont():
    for p in ("/usr/share/soundfonts/default.sf2", "/usr/share/soundfonts/FluidR3_GM.sf2",
              "/usr/share/sounds/sf2/FluidR3_GM.sf2", "/usr/share/soundfonts/freepats-general-midi.sf2"):
        if os.path.exists(p):
            return p
    return None


def decoder_for(path):
    """Devuelve (comando, tasa, canales) que decodifica a PCM s16le por stdout, o None.

    Con el audio crudo en nuestras manos, el volumen se aplica aquí mismo y cambia al instante.
    """
    ext = os.path.splitext(path)[1].lower()
    R = 44100
    if ext in (".mid", ".midi", ".kar"):
        if shutil.which("timidity"):
            return ["timidity", "-idqq", "-Or1sl", "-s", str(R), "-o", "-", path], R, 2
        sf = _soundfont()
        if shutil.which("fluidsynth") and sf:
            return ["fluidsynth", "-ni", "-q", "-T", "raw", "-O", "s16", "-r", str(R), "-F", "-", sf, path], R, 2
        return None
    if shutil.which("ffmpeg"):
        return ["ffmpeg", "-nostdin", "-loglevel", "quiet", "-i", path,
                "-f", "s16le", "-ac", "2", "-ar", str(R), "-"], R, 2
    if shutil.which("mpv"):
        return ["mpv", "--no-config", "--really-quiet", "--no-video", "--ao=pcm", "--ao-pcm-file=/dev/stdout",
                "--ao-pcm-waveheader=no", "--audio-format=s16", "--audio-channels=stereo",
                f"--audio-samplerate={R}", path], R, 2
    return None


def raw_output_for(rate, ch):
    """Reproductor que acepta PCM s16le crudo por stdin."""
    if shutil.which("pw-cat"):
        return ["pw-cat", "--playback", "--raw", "--format=s16", f"--rate={rate}", f"--channels={ch}",
                "--media-role=Music", "-P", '{"media.name": "Luces Navideñas", "application.name": "Luces Navideñas"}',
                "-"]
    if shutil.which("pacat"):
        return ["pacat", "--playback", "--raw", "--format=s16le", f"--rate={rate}", f"--channels={ch}",
                "--client-name=Luces Navideñas"]
    if shutil.which("aplay"):
        return ["aplay", "-q", "-t", "raw", "-f", "S16_LE", "-r", str(rate), "-c", str(ch), "-"]
    return None


AUDIO_ENV = dict(os.environ, LC_NUMERIC="C", LC_ALL="C.UTF-8")


MUSIC_EXT = (".mid", ".midi", ".kar", ".mp3", ".ogg", ".oga", ".opus", ".flac", ".wav", ".m4a")


