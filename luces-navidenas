class EffectArea(Gtk.DrawingArea):
    """Nieve y destellos sobre todo el escritorio.

    Solo se redibujan los rectangulitos donde estaba y donde está cada copo
    (en vez de toda la pantalla en cada cuadro). Así GTK repinta y envía al
    compositor una fracción mínima de la pantalla y no se salta cuadros.
    """

    def __init__(self, get_params, get_fps=lambda: 60):
        super().__init__()
        self.get_params = get_params
        self.get_fps = get_fps
        self.flakes = []
        self.prev = set()   # bloques ocupados en el cuadro anterior
        self.sig = None
        self.last = None
        self.t = 0.0
        self.sprites = {}
        self.connect("draw", self.on_draw)
        self.add_tick_callback(self.on_tick)

    def reset(self, w, h, kind, density):
        rng = random.Random()
        area = w * h
        base = {"nieve": 7000, "ventisca": 3200, "copos": 26000, "destellos": 9000}[kind]
        n = int(min(650, max(15, area / base * (0.25 + 1.5 * density))))
        self.flakes = []
        for _ in range(n):
            if kind == "copos":
                r = rng.uniform(5, 13)
                vy = rng.uniform(25, 55)
            elif kind == "destellos":
                r = rng.uniform(1.2, 3.2)
                vy = 0
            else:
                r = rng.uniform(1.0, 3.6)
                vy = (18 + r * 16) * (1.9 if kind == "ventisca" else 1.0)
            self.flakes.append([rng.uniform(0, w), rng.uniform(-h, h), r, vy,
                                rng.uniform(0, 6.28), rng.uniform(0.4, 1.6), rng.uniform(0.3, 1.0)])
        self.prev = set()
        self.queue_draw()  # primer cuadro completo (limpia lo que hubiera)

    # ---- geometría de cada copo
    def _extent(self, f, kind):
        if kind == "copos":
            return f[2] + 2
        if kind == "destellos":
            return f[2] * 5 + 2
        return (f[2] * 1.6 if f[2] > 2.4 else f[2]) + 2

    def _twinkle(self, f, t):
        return max(0.0, math.sin(t * f[5] * 1.7 + f[4])) ** 6

    TILE = 64  # px: la pantalla se divide en bloques; solo se repintan los que tocan un copo

    def _tiles(self, kind, h, t):
        T = self.TILE
        out = set()
        for f in self.flakes:
            if kind == "destellos":
                if self._twinkle(f, t) < 0.02:
                    continue
                x, y = f[0], f[1] % h
            else:
                x, y = f[0], f[1]
            e = self._extent(f, kind)
            x0, x1 = int((x - e) // T), int((x + e) // T)
            y0, y1 = int((y - e) // T), int((y + e) // T)
            for ty in range(y0, y1 + 1):
                for tx in range(x0, x1 + 1):
                    out.add((tx, ty))
        return out

    def _fall(self, kind, w, h, t, dt):
        """Mueve los copos y, en la misma pasada, junta los bloques que ocupan.

        Es el bucle más caliente del programa (cientos de copos, 60 veces por segundo):
        por eso usa variables locales y evita crear rangos cuando el copo cabe en un bloque.
        """
        if kind == "ventisca":
            wind = 110 + 60 * math.sin(t * 0.35)
        else:
            wind = 14 * math.sin(t * 0.2)
        T = self.TILE
        tiles = set()
        add = tiles.add
        sin = math.sin
        big = kind == "copos"
        for f in self.flakes:
            r = f[2]
            y = f[1] + f[3] * dt
            x = f[0] + (wind * (r / 3.0) + 18 * sin(t * f[5] + f[4])) * dt
            if y > h + 15:
                y = -15
                x = random.uniform(-w * 0.2, w)
            if x > w + 20:
                x -= w + 40
            elif x < -20:
                x += w + 40
            f[0], f[1] = x, y
            e = r + 2 if big else (r * 1.6 if r > 2.4 else r) + 2
            x0, x1 = int((x - e) // T), int((x + e) // T)
            y0, y1 = int((y - e) // T), int((y + e) // T)
            if x0 == x1 and y0 == y1:
                add((x0, y0))
            else:
                for ty in range(y0, y1 + 1):
                    for tx in range(x0, x1 + 1):
                        add((tx, ty))
        return tiles

    def on_tick(self, widget, clock):
        t = clock.get_frame_time() / 1e6
        # tope de cuadros por segundo: en monitores de 120/144 Hz, o en modo ahorro (30)
        if self.last is not None and t - self.last < 1.0 / self.get_fps() - 0.003:
            return True
        dt = 0.016 if self.last is None else max(0.0, min(0.1, t - self.last))
        self.last, self.t = t, t
        kind, density = self.get_params()
        w, h = self.get_allocated_width(), self.get_allocated_height()
        if w < 2:
            return True
        sig = (w, h, kind, round(density, 2))
        if sig != self.sig:
            self.sig = sig
            self.reset(w, h, kind, density)
            return True
        if kind == "destellos":
            now = self._tiles(kind, h, t)
        else:
            now = self._fall(kind, w, h, t, dt)
        dirty = now | self.prev
        self.prev = now
        if dirty:
            # agrupar bloques contiguos de cada fila en un solo rectángulo
            T = self.TILE
            rows = {}
            for tx, ty in dirty:
                rows.setdefault(ty, []).append(tx)
            region = cairo.Region()
            for ty, xs in rows.items():
                xs.sort()
                start = prev = xs[0]
                for tx in [*xs[1:], None]:
                    if tx is not None and tx == prev + 1:
                        prev = tx
                        continue
                    region.union(cairo.RectangleInt(start * T, ty * T, (prev - start + 1) * T, T))
                    if tx is not None:
                        start = prev = tx
            self.queue_draw_region(region)
        return True

    def _sprite(self, r, alpha):
        """Copo suave prerrenderizado (más barato que un degradado por copo y cuadro)."""
        key = (round(r * 4), round(alpha * 10))
        sp = self.sprites.get(key)
        if sp is None:
            R = r * 1.6
            size = math.ceil(R * 2) + 2
            sp = cairo.ImageSurface(cairo.FORMAT_ARGB32, size, size)
            c = cairo.Context(sp)
            cx = size / 2
            g = cairo.RadialGradient(cx, cx, 0, cx, cx, R)
            g.add_color_stop_rgba(0, 1, 1, 1, 0.9 * alpha + 0.1)
            g.add_color_stop_rgba(0.6, 1, 1, 1, 0.5 * alpha)
            g.add_color_stop_rgba(1, 1, 1, 1, 0)
            c.set_source(g)
            c.arc(cx, cx, R, 0, 6.3)
            c.fill()
            self.sprites[key] = sp
        return sp

    ROT_STEPS = 30  # el copo tiene simetría de 60°: 30 pasos de 2°

    def _copo(self, r, alpha, ang):
        """Copo de seis puntas prerrenderizado en 30 ángulos (antes: 18 trazos por copo y cuadro)."""
        rq, aq = round(r), round(alpha * 10) / 10
        step = round((ang % (math.pi / 3)) / (math.pi / 3) * self.ROT_STEPS) % self.ROT_STEPS
        key = ("c", rq, aq, step)
        sp = self.sprites.get(key)
        if sp is None:
            if len(self.sprites) > 3000:
                self.sprites.clear()
            size = 2 * rq + 5
            sp = cairo.ImageSurface(cairo.FORMAT_ARGB32, size, size)
            c = cairo.Context(sp)
            c.translate(size / 2, size / 2)
            c.rotate(step * (math.pi / 3) / self.ROT_STEPS)
            c.set_line_cap(cairo.LINE_CAP_ROUND)
            c.set_source_rgba(1, 1, 1, 0.55 + 0.35 * aq)
            c.set_line_width(max(1.0, rq * 0.13))
            for _k in range(6):
                c.move_to(0, 0)
                c.line_to(0, -rq)
                c.move_to(0, -rq * 0.55)
                c.line_to(rq * 0.25, -rq * 0.78)
                c.move_to(0, -rq * 0.55)
                c.line_to(-rq * 0.25, -rq * 0.78)
                c.rotate(math.pi / 3)
            c.stroke()
            self.sprites[key] = sp
        return sp

    def on_draw(self, widget, cr):
        kind, _ = self.get_params()
        # GTK ya recortó el dibujo a las zonas que cambiaron: solo se limpian esas
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        cx0, cy0, cx1, cy1 = cr.clip_extents()
        t = self.t
        h = self.get_allocated_height()
        if kind == "destellos":
            cr.set_line_width(0.8)
            for f in self.flakes:
                a = self._twinkle(f, t)
                if a < 0.02:
                    continue
                x, y, r = f[0], (f[1] % h), f[2] * (0.6 + a)
                if x + r * 3 < cx0 or x - r * 3 > cx1 or y + r * 3 < cy0 or y - r * 3 > cy1:
                    continue
                cr.set_source_rgba(1, 0.96, 0.85, 0.9 * a * f[6])
                cr.move_to(x - r * 3, y)
                cr.line_to(x + r * 3, y)
                cr.move_to(x, y - r * 3)
                cr.line_to(x, y + r * 3)
                cr.stroke()
                cr.arc(x, y, r * 0.7, 0, 6.3)
                cr.fill()
            return False
        if kind == "copos":
            for f in self.flakes:
                x, y, r = f[0], f[1], f[2]
                if x + r < cx0 or x - r > cx1 or y + r < cy0 or y - r > cy1:
                    continue
                sp = self._copo(r, f[6], t * 0.4 * (f[5] - 1) + f[4])
                off = sp.get_width() / 2
                cr.set_source_surface(sp, x - off, y - off)
                cr.paint()
            return False
        # nieve / ventisca: los grandes desde imágenes en memoria; los pequeños,
        # agrupados por brillo en un solo trazo (un relleno por grupo, no uno por copo)
        groups = {}
        for f in self.flakes:
            x, y, r = f[0], f[1], f[2]
            e = r * 1.6
            if x + e < cx0 or x - e > cx1 or y + e < cy0 or y - e > cy1:
                continue
            if r > 2.4:
                sp = self._sprite(r, f[6])
                off = sp.get_width() / 2
                cr.set_source_surface(sp, x - off, y - off)
                cr.paint()
            else:
                groups.setdefault(round(0.55 + 0.4 * f[6], 1), []).append((x, y, r))
        for alpha, pts in groups.items():
            cr.set_source_rgba(1, 1, 1, alpha)
            for x, y, r in pts:
                cr.new_sub_path()
                cr.arc(x, y, r, 0, 6.3)
            cr.fill()
        return False


