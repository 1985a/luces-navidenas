def _css_with_dialogs(css):
    """Aplica las mismas reglas a los diálogos (en GTK3 su nodo CSS es «dialog», no «window»)."""
    out = []
    for block in css.decode().split("}"):
        if "{" not in block:
            out.append(block)
            continue
        sel, body = block.split("{", 1)
        sels = [x.strip() for x in sel.split(",")]
        sels += [x.replace("window.luces-settings", "dialog.luces-settings") for x in sels
                 if "window.luces-settings" in x]
        out.append(", ".join(sels) + " {" + body)
    extra = ("dialog.luces-settings, dialog.luces-settings > box, dialog.luces-settings .dialog-vbox "
             "{ background-color: #0d1416; color: #e8eef0; }\n"
             "dialog.luces-settings .dialog-action-area { padding: 6px 12px 12px 12px; }")
    return ("}".join(out) + "\n" + extra).encode()


class SettingsWindow(Gtk.Window):
    def __init__(self, app):
        super().__init__(title=APP_NAME)
        self.app = app
        app.add_window(self)
        self.updating = False
        self.refreshers = []
        self.songs_key = None  # (carpeta, omitidas) de la lista de canciones mostrada
        self.snapshot = copy.deepcopy(app.cfg)
        self.get_style_context().add_class("luces-settings")
        self.set_default_size(1080, 820)
        self.set_icon_name("luces-navidenas")
        self.connect("delete-event", self.on_close)

        # Barra de título
        hb = Gtk.HeaderBar()
        hb.set_show_close_button(True)
        tbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        t1 = Gtk.Label(label=APP_NAME)
        t1.get_style_context().add_class("app-title")
        t2 = Gtk.Label(label="Bombillitos de Navidad para tu escritorio")
        t2.get_style_context().add_class("app-subtitle")
        tbox.pack_start(t1, False, False, 0)
        tbox.pack_start(t2, False, False, 0)
        hb.set_custom_title(tbox)
        self.power_btn = Gtk.ToggleButton()
        self.power_btn.get_style_context().add_class("power")
        self.power_btn.connect("toggled", self.on_power)
        hb.pack_end(self.power_btn)
        self.set_titlebar(hb)
        self.refreshers.append(lambda c: (self.power_btn.set_active(c["power"]), self._power_label()))

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        outer.get_style_context().add_class("main")
        self.add(outer)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        outer.pack_start(scroll, True, True, 0)
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        body.set_border_width(16)
        scroll.add(body)

        # Vista previa
        self.preview = LightsStrip(lambda: self.app.cfg, preview=True, get_fps=app.effect_fps)
        body.pack_start(self.preview, False, False, 0)
        self.refreshers.append(lambda c: self.preview.set_size_request(-1, strip_height(c) + 26))

        grid = Gtk.Grid(column_spacing=14, row_spacing=14, column_homogeneous=True)
        body.pack_start(grid, False, False, 0)

        grid.attach(self.card_modes(), 0, 0, 1, 1)
        grid.attach(self.card_speed(), 0, 1, 1, 1)
        grid.attach(self.card_misc(), 0, 2, 1, 1)
        grid.attach(self.card_bulbs(), 1, 0, 1, 1)
        grid.attach(self.card_colors(), 1, 1, 1, 2)
        grid.attach(self.card_music(), 2, 0, 1, 1)
        grid.attach(self.card_effect(), 2, 1, 1, 1)
        grid.attach(self.card_place(), 2, 2, 1, 1)

        # Botones
        actions = Gtk.Box(spacing=8)
        actions.get_style_context().add_class("actions")
        outer.pack_end(actions, False, False, 0)
        b_help = Gtk.Button(label="Ayuda")
        b_help.connect("clicked", self.on_help)
        b_quit = Gtk.Button(label="Salir")
        b_quit.get_style_context().add_class("destructive")
        b_quit.set_tooltip_text("Cierra el programa y quita las luces")
        b_quit.connect("clicked", lambda *_: self.app.quit_app())
        b_ok = Gtk.Button(label="Aceptar")
        b_ok.get_style_context().add_class("suggested-action")
        b_ok.connect("clicked", self.on_ok)
        b_cancel = Gtk.Button(label="Cancelar")
        b_cancel.connect("clicked", self.on_cancel)
        self.b_apply = Gtk.Button(label="Aplicar")
        self.b_apply.connect("clicked", self.on_apply)
        actions.pack_start(b_help, False, False, 0)
        actions.pack_start(b_quit, False, False, 0)
        ver = Gtk.Label(label=f"v{VERSION} · compilado {build_date()}")
        ver.get_style_context().add_class("hint")
        ver.set_margin_start(10)
        actions.pack_start(ver, False, False, 0)
        actions.pack_end(b_ok, False, False, 0)
        actions.pack_end(self.b_apply, False, False, 0)
        actions.pack_end(b_cancel, False, False, 0)

        self.refresh()

    # ---------- ayudantes de construcción
    def card(self, title, hint=None):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.get_style_context().add_class("card")
        lbl = Gtk.Label(label=title, xalign=0)
        lbl.get_style_context().add_class("card-title")
        box.pack_start(lbl, False, False, 0)
        if hint:
            h = Gtk.Label(label=hint, xalign=0)
            h.set_line_wrap(True)
            h.get_style_context().add_class("hint")
            box.pack_start(h, False, False, 0)
        return box

    def set(self, key, value):
        if self.updating:
            return
        new = copy.deepcopy(self.app.cfg)
        new[key] = value
        self.app.apply(new, save=False)
        self.update_apply()

    def switch_row(self, key, label, tooltip=None):
        row = Gtk.Box(spacing=10)
        lbl = Gtk.Label(label=label, xalign=0)
        lbl.set_line_wrap(True)
        sw = Gtk.Switch()
        sw.set_valign(Gtk.Align.CENTER)
        sw.connect("notify::active", lambda s, _p: self.set(key, s.get_active()))
        row.pack_start(lbl, True, True, 0)
        row.pack_end(sw, False, False, 0)
        if tooltip:
            row.set_tooltip_text(tooltip)
        self.refreshers.append(lambda c: sw.set_active(bool(c[key])))
        return row, sw

    def combo_row(self, key, label, items):
        row = Gtk.Box(spacing=10)
        row.pack_start(Gtk.Label(label=label, xalign=0), False, False, 0)
        cb = Gtk.ComboBoxText()
        for k, n in items:
            cb.append(k, n)
        cb.connect("changed", lambda c: c.get_active_id() and self.set(key, c.get_active_id()))
        row.pack_end(cb, False, False, 0)
        self.refreshers.append(lambda c: cb.set_active_id(c[key]))
        return row

    def volume_row(self, key, tooltip):
        row = Gtk.Box(spacing=8)
        row.set_tooltip_text(tooltip)
        icon = Gtk.Image()
        sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 1, 0.01)
        sc.set_draw_value(False)
        pct = Gtk.Label(xalign=1)
        pct.set_width_chars(4)
        pct.get_style_context().add_class("hint")

        def show(v):
            pct.set_text(f"{round(v * 100)}%")
            name = ("audio-volume-muted-symbolic" if v < 0.01 else "audio-volume-low-symbolic" if v < 0.34
                    else "audio-volume-medium-symbolic" if v < 0.67 else "audio-volume-high-symbolic")
            icon.set_from_icon_name(name, Gtk.IconSize.BUTTON)

        def changed(s):
            v = round(s.get_value(), 2)
            show(v)
            self.set(key, v)
        sc.connect("value-changed", changed)
        self.refreshers.append(lambda c: (sc.set_value(c[key]), show(c[key])))
        row.pack_start(icon, False, False, 0)
        row.pack_start(sc, True, True, 0)
        row.pack_end(pct, False, False, 0)
        return row

    def scale_row(self, key, lo, hi, marks):
        sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, (hi - lo) / 100.0)
        sc.set_draw_value(False)
        for v, txt in marks:
            sc.add_mark(v, Gtk.PositionType.BOTTOM, txt)
        sc.connect("value-changed", lambda s: self.set(key, round(s.get_value(), 3)))
        self.refreshers.append(lambda c: sc.set_value(c[key]))
        return sc

    # ---------- tarjetas
    def card_modes(self):
        box = self.card("Modo de parpadeo")
        grid = Gtk.Grid(column_spacing=6, row_spacing=6, column_homogeneous=True)
        group = None
        btns = {}
        for n, (key, name) in enumerate(MODES):
            b = Gtk.RadioButton.new_with_label_from_widget(group, name)
            group = group or b
            b.set_mode(False)
            b.get_style_context().add_class("mode-btn")
            b.get_child().set_xalign(0)
            b.connect("toggled", lambda w, k=key: w.get_active() and self.set("mode", k))
            grid.attach(b, n % 2, n // 2, 1, 1)
            btns[key] = b
        box.pack_start(grid, False, False, 0)
        self.refreshers.append(lambda c: btns.get(c["mode"], btns["some"]).set_active(True))
        return box

    def card_speed(self):
        box = self.card("Velocidad")
        box.pack_start(self.scale_row("rate", 0, 1, [(0, "Lento"), (0.5, None), (1, "Rápido")]), False, False, 0)
        row, _ = self.switch_row("smooth", "Transición suave",
                                 "Las luces se encienden y apagan con un desvanecido, como bombillos reales")
        box.pack_start(row, False, False, 0)
        return box

    def card_bulbs(self):
        box = self.card("Bombillos")
        box.pack_start(self.combo_row("bulb", "Tipo", BULBS), False, False, 0)
        lbl = Gtk.Label(label="Tamaño", xalign=0)
        box.pack_start(lbl, False, False, 0)
        box.pack_start(self.scale_row("size", 0.6, 1.8, [(0.6, "Pequeño"), (1.0, None), (1.8, "Grande")]),
