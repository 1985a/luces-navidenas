        except OSError:
            pass


def mains_offline():
    """True si hay cargador (sysfs) y está desconectado. Solo se usa si UPower no está."""
    base = "/sys/class/power_supply"
    mains = []
    try:
        names = os.listdir(base)
    except OSError:
        return False
    for d in names:
        try:
            with open(os.path.join(base, d, "type"), encoding="ascii") as f:
                if f.read().strip() != "Mains":
                    continue
            with open(os.path.join(base, d, "online"), encoding="ascii") as f:
                mains.append(f.read().strip() == "1")
        except OSError:
            continue
    return bool(mains) and not any(mains)


class PowerWatcher:
    """Sabe si conviene ahorrar (batería o perfil «ahorro de energía») escuchando a UPower y a
    power-profiles-daemon por D-Bus: se entera de los cambios sin consultar nada cada pocos segundos.
    """

    PROFILES = (("org.freedesktop.UPower.PowerProfiles", "/org/freedesktop/UPower/PowerProfiles"),
                ("net.hadess.PowerProfiles", "/net/hadess/PowerProfiles"))
    FALLBACK_POLL = 30  # s: solo sin UPower, mirando sysfs (lectura instantánea, sin hilos)

    def __init__(self, on_change):
        self.on_change = on_change
        self.on_battery = False
        self.power_saver = False
        self.proxies = []  # se guardan: si se liberan, dejan de llegar las señales
        self.poll_id = 0
        self.tried_old_profiles = False
        try:
            self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        except GLib.Error:
            self._start_fallback()
            return
        self._watch("org.freedesktop.UPower", "/org/freedesktop/UPower", "org.freedesktop.UPower",
                    self._upower_ready)
        self._watch(*self.PROFILES[0], self.PROFILES[0][0], self._profiles_ready)

    @property
    def saving(self):
        return self.on_battery or self.power_saver

    def _watch(self, name, path, iface, ready):
        Gio.DBusProxy.new(self.bus, Gio.DBusProxyFlags.DO_NOT_AUTO_START, None, name, path, iface, None, ready)

    def _ready(self, result):
        try:
            proxy = Gio.DBusProxy.new_finish(result)
        except GLib.Error:
            return None
        return proxy if proxy.get_name_owner() else None

    def _upower_ready(self, _src, result):
        proxy = self._ready(result)
        if proxy is None:
            self._start_fallback()
            return
        self.proxies.append(proxy)
        proxy.connect("g-properties-changed", lambda p, *_: self._read_upower(p))
        self._read_upower(proxy)

    def _read_upower(self, proxy):
        v = proxy.get_cached_property("OnBattery")
        self._set(on_battery=bool(v and v.unpack()))

    def _profiles_ready(self, _src, result):
        proxy = self._ready(result)
        if proxy is None:
            if not self.tried_old_profiles:
                self.tried_old_profiles = True  # power-profiles-daemon antiguo: nombre net.hadess
                self._watch(*self.PROFILES[1], self.PROFILES[1][0], self._profiles_ready)
            return
        self.proxies.append(proxy)
        proxy.connect("g-properties-changed", lambda p, *_: self._read_profile(p))
        self._read_profile(proxy)

    def _read_profile(self, proxy):
        v = proxy.get_cached_property("ActiveProfile")
        self._set(power_saver=bool(v and v.unpack() == "power-saver"))

    def _start_fallback(self):
        if self.poll_id:
            return

        def poll():
            self._set(on_battery=mains_offline())
            return True
        poll()
        self.poll_id = GLib.timeout_add_seconds(self.FALLBACK_POLL, poll)

    def _set(self, **values):
        before = self.saving
        for k, v in values.items():
            setattr(self, k, v)
        if self.saving != before:
            self.on_change(self.saving)


def trim_memory():
    """Devuelve al sistema la memoria libre del proceso (tras cerrar las opciones)."""
    try:
        ctypes.CDLL("libc.so.6").malloc_trim(0)
    except (OSError, AttributeError):
        pass


