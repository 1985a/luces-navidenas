        dlg = Gtk.FileChooserDialog(title="Carpeta de música navideña", transient_for=self,
                                    action=Gtk.FileChooserAction.SELECT_FOLDER)
        dlg.add_buttons("Cancelar", Gtk.ResponseType.CANCEL, "Elegir", Gtk.ResponseType.ACCEPT)
        dlg.set_current_folder(self.app.cfg["music_dir"])
        if dlg.run() == Gtk.ResponseType.ACCEPT:
            self.set("music_dir", dlg.get_filename())
            self.updating = True
            self.refresh_songs(self.app.cfg)
            self.updating = False
        dlg.destroy()

