class SoundFx:
    """Efectos cortos (clic, encender, apagar) con el reproductor del sistema."""

    def __init__(self):
        self.last = 0.0
        self.volume = 0.5
        self.procs = []  # reproductores lanzados; se recogen para no dejar procesos zombis

    def play(self, name, min_gap=0.0):
        now = time.monotonic()
        if now - self.last < min_gap or self.volume <= 0.01:
            return
        self.last = now
        self.procs = [p for p in self.procs if p.poll() is None]
        path = os.path.join(CACHE_DIR, name)
        cmd = wav_command(path, self.volume) if os.path.exists(path) else None
        if cmd:
            try:
                self.procs.append(subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                                   start_new_session=True, env=AUDIO_ENV))
            except OSError:
                pass


class MusicPlayer:
    """Reproduce la lista en bucle: decodificador → volumen (en Python) → PipeWire.

    Corre en un hilo propio. Los procesos que lanza se guardan bajo un candado porque
    stop() (hilo de la interfaz) los mata mientras el hilo de música puede estar creando otro.
    """

    CHUNK_FRAMES = 2048  # ≈ 46 ms a 44,1 kHz: el volumen responde casi al instante
    MAX_AHEAD = 0.2      # s de audio que se adelantan al reproductor como máximo

    def __init__(self):
        self.thread = None
        self.stop_ev = threading.Event()
        self.lock = threading.Lock()
        self.procs = []
        self.tracks = []
        self.status = ""
        self.volume = 0.7

    def set_volume(self, vol):
        self.volume = max(0.0, min(1.0, vol))

    def set_tracks(self, tracks):
        if tracks != self.tracks:
            self.tracks = list(tracks)
            if self.running():
                self.stop()
                self.start()

    def running(self):
        return self.thread is not None and self.thread.is_alive()

    def start(self):
        if self.running() or not self.tracks:
            return
        self.stop_ev.clear()
        self.thread = threading.Thread(target=self._loop, name="musica", daemon=True)
        self.thread.start()

    def stop(self):
        self.stop_ev.set()
        self._kill()
        if self.thread:
            self.thread.join(timeout=2)
        self.thread = None

    # ---- procesos
    def _spawn(self, cmd, **kw):
        p = subprocess.Popen(cmd, stderr=subprocess.DEVNULL, start_new_session=True, env=AUDIO_ENV, **kw)
        with self.lock:
            self.procs.append(p)
        if self.stop_ev.is_set():  # stop() llegó mientras se lanzaba: no dejarlo huérfano
            self._kill()
        return p

    def _kill(self):
        """Mata los procesos, los espera (sin zombis) y cierra sus tuberías."""
        with self.lock:
            procs, self.procs = self.procs, []
        for p in procs:
            if p.poll() is None:
                try:
                    p.kill()
                except OSError:
                    pass
            try:
                p.wait(timeout=1)
            except subprocess.TimeoutExpired:
                pass
            for pipe in (p.stdin, p.stdout):
                if pipe:
                    try:
                        pipe.close()
                    except OSError:
                        pass

    # ---- fuentes de audio
    def _wav_source(self, path):
        """WAV de 16 bits leído directamente (sin decodificador externo), o None."""
        try:
            w = wave.open(path, "rb")  # noqa: SIM115 (lo cierra quien llama, al terminar la canción)
        except (OSError, wave.Error, EOFError):
            return None
        if w.getsampwidth() != 2:
            w.close()
            return None

        def gen():
            while not self.stop_ev.is_set():
                data = w.readframes(self.CHUNK_FRAMES)
                if not data:
                    return
                yield data
        return gen(), w.getframerate(), w.getnchannels(), w.close

    def _source(self, path):
        """(generador de bytes PCM, tasa, canales, cerrar) o None si no se puede decodificar."""
        if path.lower().endswith(".wav"):
            src = self._wav_source(path)
            if src:
                return src
        dec = decoder_for(path)
        if not dec:
            return None
        cmd, rate, ch = dec
        try:
            p = self._spawn(cmd, stdout=subprocess.PIPE, stdin=subprocess.DEVNULL)
        except OSError:
            return None
        size = self.CHUNK_FRAMES * ch * 2

        def gen():
            while not self.stop_ev.is_set():
                data = p.stdout.read(size)
                if not data:
                    return
                yield data
        return gen(), rate, ch, lambda: None  # el proceso lo cierra _kill()

    @staticmethod
    def _scale(data, gain):
        """Aplica la ganancia a PCM s16le."""
        if gain >= 0.999:
            return data
        if len(data) % 2:
            data = data[:-1]
        if gain <= 0.001:
            return bytes(len(data))
        a = array.array("h")
        a.frombytes(data)
        if sys.byteorder != "little":
            a.byteswap()
        a = array.array("h", [int(x * gain) for x in a])
        if sys.byteorder != "little":
            a.byteswap()
        return a.tobytes()

    def _play(self, path):
        src = self._source(path)
        if not src:
            return False
        chunks, rate, ch, close_src = src
        try:
            return self._pump(chunks, rate, ch)
        finally:
            close_src()
            self._kill()

    def _pump(self, chunks, rate, ch):
        """Envía el audio al reproductor al ritmo real, con el volumen actual."""
        out_cmd = raw_output_for(rate, ch)
        if not out_cmd:
            self.status = "Falta pw-cat (paquete pipewire) para reproducir audio."
            return False
        try:
            out = self._spawn(out_cmd, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL)
        except OSError:
            return False
        gain = self.volume ** 2  # curva perceptual: el deslizador se siente más parejo
        bytes_per_s = float(rate * ch * 2)
        written = 0
        t0 = time.monotonic()
        try:
            for data in chunks:
                # Máx. MAX_AHEAD adelantado: así un cambio de volumen se oye al momento
                ahead = written / bytes_per_s - (time.monotonic() - t0)
                if ahead > self.MAX_AHEAD and self.stop_ev.wait(ahead - self.MAX_AHEAD):
                    break
                gain += (self.volume ** 2 - gain) * 0.5  # suaviza saltos bruscos
                out.stdin.write(self._scale(data, gain))
                out.stdin.flush()
                written += len(data)
            out.stdin.close()
        except (BrokenPipeError, OSError, ValueError):
            pass
        # dejar que suene lo que queda en el reproductor (o salir ya si nos detienen)
        while out.poll() is None and not self.stop_ev.wait(0.1):
            pass
        return True

    def _loop(self):
        # El villancico incluido se genera al arrancar: esperar a que esté (o a que nos detengan)
        while not SOUNDS_READY.wait(0.2):
            if self.stop_ev.is_set():
                return
        while not self.stop_ev.is_set():
            played = False
            for path in list(self.tracks):
                if self.stop_ev.is_set():
                    return
                real = os.path.join(CACHE_DIR, "jingle-bells.wav") if path == BUILTIN_SONG else path
                if self._play(real):
                    played = True
                    self.stop_ev.wait(0.8)
            if not played:
                if not self.status:
                    self.status = "No hay forma de reproducir estas canciones."
                return


