    def _power_label(self):
        self.power_btn.set_label("⏻  Encendidas" if self.power_btn.get_active() else "⏻  Apagadas")

    def on_power(self, btn):
        self._power_label()
        if not self.updating:
            self.app.set_power(btn.get_active())

    def open(self):
        self.snapshot = copy.deepcopy(self.app.cfg)
        self.refresh()
        self.show_all()
        self.music_status.set_visible(bool(self.music_status.get_text()))
        self.present()

    def on_apply(self, *_):
        self.app.save()
        self.snapshot = copy.deepcopy(self.app.cfg)
        self.update_apply()

    def on_ok(self, *_):
        self.app.save()
        self.close_to_background()

    def on_cancel(self, *_):
        self.app.apply(copy.deepcopy(self.snapshot), save=True)
        self.refresh()
        self.close_to_background()

    def on_close(self, *_):
        self.app.save()
        self.close_to_background()
        return True

    def close_to_background(self):
        """Oculta la ventana; las luces siguen. Avisa cómo volver (una vez, salvo que lo pidan de nuevo)."""
        if not self.app.cfg.get("bg_notice", True):
            self.hide()
            GLib.timeout_add(1500, lambda: trim_memory() and False)
