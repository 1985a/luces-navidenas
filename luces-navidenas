class LightsStrip(Gtk.DrawingArea):
    """La tira de luces en GTK (ventanas sobre el escritorio y vista previa).

    El trabajo lo hace nucleo.StripEngine; aquí solo se conecta con el reloj de cuadros de GTK:
    se pide repintar lo que el motor indica y, si nada se mueve, se suelta el reloj hasta el
    próximo cambio.
    """

    def __init__(self, get_cfg, preview=False, get_fps=lambda: 60):
        super().__init__()
        self.get_cfg = get_cfg
        self.get_fps = get_fps
        self.engine = StripEngine(preview)
        self.connect("draw", self.on_draw)
        self.tick_id = self.add_tick_callback(self.on_tick)
        self.sleep_id = 0

    def wake(self, force=False):
        """Vuelve a animar (p. ej. tras cambiar una opción)."""
        if force:
            self.engine.force = True
        if self.sleep_id:
            GLib.source_remove(self.sleep_id)
            self.sleep_id = 0
        if self.tick_id is None:
            self.engine.last_t = None
            self.tick_id = self.add_tick_callback(self.on_tick)

    def _sleep(self, seconds):
        """Nada se mueve: soltar el reloj de cuadros hasta el próximo cambio."""
        self.tick_id = None

        def again():
            self.sleep_id = 0
            self.wake()
            return False
        self.sleep_id = GLib.timeout_add(max(15, int(seconds * 1000)), again)

    def on_tick(self, _widget, clock):
        t = clock.get_frame_time() / 1e6
        w = self.get_allocated_width()
        if w <= 1 or not self.engine.frame_due(t, self.get_fps()):
            return True
        f = self.engine.tick(t, self.get_cfg(), w)
        if f.redraw == "all":
            self.queue_draw()
        elif f.redraw == "spans":
            h = self.get_allocated_height()
            for x0, x1 in f.spans:
                self.queue_draw_area(x0, 0, x1 - x0, h)
        if f.busy or f.wait < SLEEP_MIN:
            return True
        self._sleep(f.wait)
        return False

    def on_draw(self, _widget, cr):
        self.engine.draw(cr, self.get_allocated_width(), self.get_allocated_height(), self.get_cfg(),
                         self.get_scale_factor())
        return False


