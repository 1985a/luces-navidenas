    # ---------- arranque
    def do_startup(self):
        Gtk.Application.do_startup(self)
        Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", True)
        prov = Gtk.CssProvider()
        prov.load_from_data(_css_with_dialogs(CSS))
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        here = os.path.dirname(os.path.realpath(__file__))
        if os.path.exists(os.path.join(here, "luces-navidenas.svg")):
            Gtk.IconTheme.get_default().append_search_path(here)  # ejecutando desde la carpeta
        if not layer_shell_ok():
            msg = ("Luces Navideñas necesita una sesión Wayland con soporte de wlr-layer-shell "
                   "(Sway, Hyprland, river, KDE Plasma…) y el paquete gtk-layer-shell.")
            print("Error: " + msg, file=sys.stderr)
            dlg = Gtk.MessageDialog(message_type=Gtk.MessageType.ERROR, buttons=Gtk.ButtonsType.CLOSE,
                                    text="No se pueden mostrar las luces")
            dlg.format_secondary_text(msg)
            dlg.run()
            dlg.destroy()
            sys.exit(1)

    def start(self):
        self.started = True
        self.hold()
        threading.Thread(target=generate_sounds, daemon=True).start()
        self.tray = Tray(self)
        self.build_strips()
        self.update_effect()
        GLib.timeout_add(1500, self._delayed_music)
        self.schedule_global_tick()
        try:  # un adorno no debe competir con lo que el usuario está haciendo
            os.nice(5)
        except OSError:
            pass
        self.power = PowerWatcher(self._on_saving_changed)
        GLib.timeout_add_seconds(5, lambda: trim_memory() and False)
        disp = Gdk.Display.get_default()
        disp.connect("monitor-added", lambda *_: self.schedule_rebuild())
        disp.connect("monitor-removed", lambda *_: self.schedule_rebuild())

    def _delayed_music(self):
        self.update_music()
        return False

    def do_command_line(self, cl):
        args = cl.get_arguments()[1:]
        first = not self.started
        if "--salir" in args:
            if self.started:
                self.quit_app()
            return 0
        if first:
            self.start()
        if "--alternar" in args:
            self.set_power(not self.cfg["power"])
        elif "--opciones" in args:
            self.show_settings()
        elif first:
            if self.cfg["show_options"] and "--oculto" not in args:
                self.show_settings()
        elif not args:
            self.show_settings()
        return 0

    # ---------- monitores y ventanas
    def monitors(self):
        disp = Gdk.Display.get_default()
        mons = [disp.get_monitor(i) for i in range(disp.get_n_monitors())]
        if self.cfg["monitors"] == "primary" and mons:
            p = disp.get_primary_monitor()
            return [p if p is not None else mons[0]]
        return mons

    def build_strips(self):
        for w in self.strips:
            w.destroy()
        self.strips = []
        for m in self.monitors():
            w = StripWindow(self, m)
            self.add_window(w)
            w.show_all()
            self.strips.append(w)

    def schedule_rebuild(self):
        if self.rebuild_id:
            GLib.source_remove(self.rebuild_id)

        def go():
            self.rebuild_id = 0
            self.build_strips()
            self.update_effect(rebuild=True)
            return False
        self.rebuild_id = GLib.timeout_add(250, go)

    def effect_params(self):
        return self.cfg["effect"], self.cfg["effect_density"]

    def update_effect(self, rebuild=False):
        want = (self.cfg["power"] and self.cfg["effect_on"]) or time.monotonic() < self.test_until
        if rebuild or not want:
            for w in self.effects:
                w.destroy()
            self.effects = []
        if want and not self.effects:
            for m in self.monitors():
                w = EffectWindow(self, m, self.effect_params)
                self.add_window(w)
                w.show_all()
                self.effects.append(w)

    def test_effect(self):
        self.test_until = time.monotonic() + 10
        self.update_effect()

        def end():
            self.update_effect()
            return False
        GLib.timeout_add(10200, end)

    def update_music(self):
        skip = set(self.cfg.get("music_skip", []))
        tracks = [p for p, _ in list_songs(self.cfg["music_dir"]) if p not in skip]
        self.music.set_tracks(tracks)
        if self.cfg["music"] and self.cfg["power"]:
            self.music.start()
        else:
            self.music.stop()

    # ---------- configuración
    def apply(self, new, save=False):
        old = self.cfg
        self.cfg = new
        if any(old[k] != new[k] for k in LAYOUT_KEYS):
            self.schedule_rebuild()
        if any(old[k] != new[k] for k in ("effect_on", "power")):
            self.update_effect()
        if old["volume"] != new["volume"]:
            self.music.set_volume(new["volume"])
        self.sfx.volume = new["fx_volume"]
        if any(old[k] != new[k] for k in ("music", "music_dir", "music_skip", "power")):
            self.update_music()
        if old["autostart"] != new["autostart"]:
            write_autostart(new["autostart"])
        if old["power"] != new["power"] and new["sound"]:
            self.sfx.play("encender.wav" if new["power"] else "apagar.wav")
        if self.tray:
            self.tray.sync()
        for w in self.strips:  # cualquier cambio visible: redibujar las luces enseguida
            w.strip.wake(force=True)
        if self.settings:
            self.settings.preview.wake(force=True)
        if any(old[k] != new[k] for k in ("mode", "rate", "power")):
            self.schedule_global_tick()
        if save:
            self.save()

    def save(self):
        write_json_atomic(CONFIG_FILE, self.cfg)
        self.saved_cfg = copy.deepcopy(self.cfg)
        if self.settings:
            self.settings.update_apply()

    def set_power(self, on):
        """El interruptor se aplica y se guarda al momento (sin tocar otros cambios pendientes)."""
        if on == self.cfg["power"]:
            return
        new = copy.deepcopy(self.cfg)
        new["power"] = on
        self.apply(new, save=False)
        self.saved_cfg["power"] = on
        write_json_atomic(CONFIG_FILE, self.saved_cfg)
        if self.settings:
            self.settings.snapshot["power"] = on
            self.settings.updating = True
            self.settings.power_btn.set_active(on)
            self.settings._power_label()
            self.settings.updating = False
            self.settings.update_apply()

    # ---------- latido global: sonidos y LEDs de la bandeja
    def effect_fps(self):
        f = self.cfg.get("fluidez", "auto")
        if f == "eco" or (f == "auto" and self.saver):
            return 30
        return 60

    def _on_saving_changed(self, saving):
        """UPower / power-profiles avisaron de un cambio (para la fluidez automática)."""
        self.saver = saving

    def schedule_global_tick(self):
        """Sonido de los parpadeos y LEDs de la bandeja: despierta solo en cada parpadeo."""
        if self.gtick_id:
            GLib.source_remove(self.gtick_id)
        cfg = self.cfg
        if not cfg["power"] or cfg["mode"] in CONTINUOUS_MODES or cfg["mode"] == "none":
            delay = 1.0
        else:
            iv = rate_to_interval(cfg["rate"])
            delay = max(0.05, iv - (time.monotonic() % iv) + 0.002)
        self.gtick_id = GLib.timeout_add(int(delay * 1000), self.global_tick)

    def global_tick(self):
        self.gtick_id = 0
        cfg = self.cfg
        if cfg["power"] and cfg["mode"] not in CONTINUOUS_MODES and cfg["mode"] != "none":
            s = int(time.monotonic() / rate_to_interval(cfg["rate"]))
            if s != self.last_step:
                self.last_step = s
                if cfg["sound"] and cfg["mode"] in ("all", "alternate", "chase"):
                    self.sfx.play("tic.wav", min_gap=0.25)
                if cfg["tray_leds"] and self.tray and self.tray.available:
                    self.tray.blink()
        self.schedule_global_tick()
        return False

    # ---------- ventanas
    def show_settings(self):
        if self.settings is None:
            self.settings = SettingsWindow(self)
        self.settings.open()

    def change_volume(self, step):
        new = copy.deepcopy(self.cfg)
        new["volume"] = round(max(0.0, min(1.0, new["volume"] + step)), 2)
        self.apply(new, save=True)
        if self.settings and self.settings.get_visible():
            self.settings.refresh()

    def quit_app(self):
        if getattr(self, "_quitting", False):
            return
        self._quitting = True
        self.music.stop()
        for w in self.strips + self.effects:
            w.destroy()
        if self.started:
            self.release()
        self.quit()


def main():
    if "-h" in sys.argv or "--ayuda" in sys.argv or "--help" in sys.argv:
        print(__doc__)
        return 0
    if "--version" in sys.argv:
        print(f"{APP_NAME} {VERSION} (compilado: {build_date()})")
        return 0
    app = App()

    # Ctrl+C / kill: cerrar limpio (detiene la música). GLib atiende la señal en su propio
    # bucle; un manejador de Python no correría hasta que algo despertara al intérprete.
    def on_signal():
        app.quit_app()
        return GLib.SOURCE_REMOVE
    for sig in (signal.SIGINT, signal.SIGTERM):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, on_signal)
    try:
        return app.run(sys.argv)
    except KeyboardInterrupt:
        app.music.stop()
        return 0


if __name__ == "__main__":
    sys.exit(main())
