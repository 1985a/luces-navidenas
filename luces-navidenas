class EffectArea(Gtk.DrawingArea):
    """Nieve y destellos sobre todo el escritorio (el trabajo lo hace nucleo.EffectEngine).

    Solo se piden repintar los bloques donde estaba y donde está cada copo, en vez de toda
    la pantalla en cada cuadro: GTK envía al compositor una fracción mínima de la pantalla.
    """

    def __init__(self, get_params, get_fps=lambda: 60):
        super().__init__()
        self.get_params = get_params
        self.get_fps = get_fps
        self.engine = EffectEngine()
        self.last = None
        self.connect("draw", self.on_draw)
        self.add_tick_callback(self.on_tick)

    def on_tick(self, _widget, clock):
        t = clock.get_frame_time() / 1e6
        # tope de cuadros por segundo: en monitores de 120/144 Hz, o en modo ahorro (30)
        if self.last is not None and t - self.last < 1.0 / self.get_fps() - 0.003:
            return True
        dt = 0.016 if self.last is None else max(0.0, min(0.1, t - self.last))
        self.last = t
        kind, density = self.get_params()
        w, h = self.get_allocated_width(), self.get_allocated_height()
        if w < 2:
            return True
        dirty = self.engine.step(t, dt, w, h, kind, density)
        if dirty == "all":
            self.queue_draw()  # primer cuadro completo (limpia lo que hubiera)
        elif dirty:
            region = cairo.Region()
            for x, y, rw, rh in EffectEngine.tile_rects(dirty):
                region.union(cairo.RectangleInt(x, y, rw, rh))
            self.queue_draw_region(region)
        return True

    def on_draw(self, _widget, cr):
        # GTK ya recortó el dibujo a las zonas que cambiaron: el motor solo pinta esas
        self.engine.draw(cr, self.get_allocated_height(), self.get_params()[0])
        return False


