SNI_PATH = "/StatusNotifierItem"
MENU_PATH = "/MenuBar"
WATCHER = "org.kde.StatusNotifierWatcher"


class Tray:
    """Icono de bandeja propio (StatusNotifierItem + dbusmenu), sin libayatana.

    Clic izquierdo: opciones · clic central: encender/apagar ·
    rueda: volumen de la música · clic derecho: menú (si la bandeja lo admite).
    """

    MENU = [(1, "power"), (2, "options"), (3, "sep"), (4, "quit")]

    def __init__(self, app):
        self.app = app
        self.frame = 0
        self.last_blink = 0.0
        self.revision = 1
        self.bus = None
        self.registered = False
        try:
            self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        except GLib.Error:
            return
        cols = [_hex("#ff3b3b"), _hex("#2fdc5a"), _hex("#ffd23a")]
        # Las imágenes del icono se convierten UNA vez a variantes D-Bus nativas.
        # (Antes se rearmaban byte a byte en cada consulta de la barra y eso
        # bloqueaba el hilo principal: la nieve daba tirones al ritmo del parpadeo.)
        self.frames = [self._pix_variant([render_icon_pixmap(c, 1.0, sz) for sz in (22, 32, 48)]) for c in cols]
        self.off = self._pix_variant([render_icon_pixmap(cols[0], 0.0, sz) for sz in (22, 32, 48)])
        node = Gio.DBusNodeInfo.new_for_xml(SNI_XML)
        self.bus.register_object(SNI_PATH, node.interfaces[0], self._on_call, self._get_prop, None)
        self.bus.register_object(MENU_PATH, node.interfaces[1], self._on_call, self._get_prop, None)
        self.name = "org.kde.StatusNotifierItem-%d-1" % os.getpid()
        Gio.bus_own_name_on_connection(self.bus, self.name, Gio.BusNameOwnerFlags.NONE, None, None)
        Gio.bus_watch_name_on_connection(self.bus, WATCHER, Gio.BusNameWatcherFlags.NONE,
                                         self._watcher_up, self._watcher_down)

    @staticmethod
    def _pix_variant(pixmaps):
        ay = GLib.VariantType.new("ay")
        items = [GLib.Variant.new_tuple(GLib.Variant("i", w), GLib.Variant("i", h),
                                        GLib.Variant.new_from_bytes(ay, GLib.Bytes.new(data), True))
                 for w, h, data in pixmaps]
        return GLib.Variant.new_array(GLib.VariantType.new("(iiay)"), items)

    @property
    def available(self):
        return self.bus is not None

    # ---- registro con la bandeja
    def _watcher_up(self, conn, name, owner):
        conn.call(WATCHER, "/StatusNotifierWatcher", WATCHER, "RegisterStatusNotifierItem",
                  GLib.Variant("(s)", (self.name,)), None, Gio.DBusCallFlags.NONE, -1, None, None)
        self.registered = True

    def _watcher_down(self, *_):
        self.registered = False

    def _emit(self, path, iface, signal_name, params=None):
        if self.bus:
            try:
                self.bus.emit_signal(None, path, iface, signal_name, params)
            except GLib.Error:
                pass

    # ---- propiedades
    def _pixmaps(self):
        if not self.app.cfg["power"]:
            return self.off
        return self.frames[self.frame % 3]

    def _get_prop(self, conn, sender, path, iface, prop):
        # Solo se construye lo que se pide (la barra consulta varias veces por segundo)
        if path == MENU_PATH:
            if prop == "Version":
                return GLib.Variant("u", 3)
            if prop == "TextDirection":
                return GLib.Variant("s", "ltr")
            if prop == "Status":
                return GLib.Variant("s", "normal")
            if prop == "IconThemePath":
                return GLib.Variant("as", [])
            return None
        if prop == "IconPixmap":
            return self._pixmaps()
        if prop == "ToolTip":
            estado = "Luces encendidas" if self.app.cfg["power"] else "Luces apagadas"
            return GLib.Variant("(sa(iiay)ss)", ("", [], APP_NAME,
                                estado + "\nClic: opciones · Clic central: encender/apagar"))
        simple = {
            "Category": ("s", "ApplicationStatus"), "Id": ("s", "luces-navidenas"),
            "Title": ("s", APP_NAME), "Status": ("s", "Active"), "WindowId": ("i", 0),
            "IconName": ("s", ""), "OverlayIconName": ("s", ""), "AttentionIconName": ("s", ""),
            "ItemIsMenu": ("b", False), "Menu": ("o", MENU_PATH),
        }
        if prop in simple:
            t, v = simple[prop]
            return GLib.Variant(t, v)
        return None

    # ---- menú (dbusmenu)
    def _item_props(self, kind):
        if kind == "power":
            return {"label": GLib.Variant("s", "Luces encendidas"),
                    "toggle-type": GLib.Variant("s", "checkmark"),
                    "toggle-state": GLib.Variant("i", 1 if self.app.cfg["power"] else 0)}
        if kind == "options":
            return {"label": GLib.Variant("s", "Opciones…")}
        if kind == "sep":
            return {"type": GLib.Variant("s", "separator")}
        return {"label": GLib.Variant("s", "Salir")}

    def _layout(self):
        children = [GLib.Variant("(ia{sv}av)", (i, self._item_props(k), [])) for i, k in self.MENU]
        return (0, {"children-display": GLib.Variant("s", "submenu")}, children)

    def _menu_event(self, item_id, event):
        if event != "clicked":
            return
        kind = dict(self.MENU).get(item_id)
        if kind == "power":
            GLib.idle_add(lambda: self.app.set_power(not self.app.cfg["power"]) and False)
        elif kind == "options":
            GLib.idle_add(lambda: self.app.show_settings() and False)
        elif kind == "quit":
            GLib.idle_add(lambda: self.app.quit_app() and False)

    # ---- llamadas D-Bus
    def _on_call(self, conn, sender, path, iface, method, params, inv):
        ret = None
        if method == "Activate":
            GLib.idle_add(lambda: self.app.show_settings() and False)
        elif method == "SecondaryActivate":
            GLib.idle_add(lambda: self.app.set_power(not self.app.cfg["power"]) and False)
        elif method == "ContextMenu":
            # Bandeja sin menús: mostramos las opciones, que tienen todo
            GLib.idle_add(lambda: self.app.show_settings() and False)
        elif method == "Scroll":
            delta, orient = params.unpack()
            if orient.lower() == "vertical" and delta:
                step = -0.05 if delta > 0 else 0.05
                GLib.idle_add(lambda: self.app.change_volume(step) and False)
        elif method == "GetLayout":
            ret = GLib.Variant("(u(ia{sv}av))", (self.revision, self._layout()))
        elif method == "GetGroupProperties":
            ids, _names = params.unpack()
            items = [(i, self._item_props(k)) for i, k in self.MENU if not ids or i in ids]
            ret = GLib.Variant("(a(ia{sv}))", (items,))
        elif method == "GetProperty":
            item_id, name = params.unpack()
            val = self._item_props(dict(self.MENU).get(item_id, "quit")).get(name, GLib.Variant("s", ""))
            ret = GLib.Variant("(v)", (val,))
        elif method == "Event":
            item_id, event, _data, _ts = params.unpack()
            self._menu_event(item_id, event)
        elif method == "EventGroup":
            for item_id, event, _data, _ts in params.unpack()[0]:
                self._menu_event(item_id, event)
            ret = GLib.Variant("(ai)", ([],))
        elif method == "AboutToShow":
            ret = GLib.Variant("(b)", (False,))
        elif method == "AboutToShowGroup":
            ret = GLib.Variant("(aiai)", ([], []))
        inv.return_value(ret)

    # ---- estado
    def sync(self):
        if not self.bus:
            return
        self.revision += 1
        self._emit(MENU_PATH, "com.canonical.dbusmenu", "LayoutUpdated",
                   GLib.Variant("(ui)", (self.revision, 0)))
        self._emit(SNI_PATH, "org.kde.StatusNotifierItem", "NewIcon")
        self._emit(SNI_PATH, "org.kde.StatusNotifierItem", "NewToolTip")

    def blink(self):
        now = time.monotonic()
        if not self.bus or now - self.last_blink < 0.6:
            return
        self.last_blink = now
        self.frame += 1
        self._emit(SNI_PATH, "org.kde.StatusNotifierItem", "NewIcon")


