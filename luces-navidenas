SOCKETS = {"c9": (0.20, 0.46), "mini": (0.13, 0.40), "globo": (0.16, 0.40), "estrella": (0.13, 0.34)}


def glass_path(cr, kind, u):
    """Traza el vidrio del bombillo. Devuelve (centro_y, radio)."""
    if kind == "mini":
        cr.move_to(-0.10 * u, 0.36 * u)
        cr.curve_to(-0.28 * u, 0.75 * u, -0.22 * u, 1.45 * u, 0, 1.64 * u)
        cr.curve_to(0.22 * u, 1.45 * u, 0.28 * u, 0.75 * u, 0.10 * u, 0.36 * u)
        cr.close_path()
        return 1.0 * u, 0.25 * u
    if kind == "globo":
        cr.new_sub_path()
        cr.arc(0, 0.80 * u, 0.40 * u, 0, 2 * math.pi)
        cr.close_path()
        return 0.80 * u, 0.40 * u
    if kind == "estrella":
        cx, cy, ro, ri = 0, 0.88 * u, 0.54 * u, 0.23 * u
        for k in range(10):
            a = -math.pi / 2 + k * math.pi / 5
            r = ro if k % 2 == 0 else ri
            x, y = cx + r * math.cos(a), cy + r * math.sin(a)
            (cr.move_to if k == 0 else cr.line_to)(x, y)
        cr.close_path()
        return cy, 0.42 * u
    # c9 clásica
    cr.move_to(-0.17 * u, 0.40 * u)
    cr.curve_to(-0.53 * u, 0.85 * u, -0.42 * u, 1.42 * u, 0, 1.62 * u)
    cr.curve_to(0.42 * u, 1.42 * u, 0.53 * u, 0.85 * u, 0.17 * u, 0.40 * u)
    cr.close_path()
    return 1.03 * u, 0.36 * u


def glass_metrics(kind, u):
    s = cairo.ImageSurface(cairo.FORMAT_A8, 1, 1)
    return glass_path(cairo.Context(s), kind, u)


_METRIC_CACHE = {}


def metrics(kind, u):
    key = (kind, round(u, 2))
    if key not in _METRIC_CACHE:
        _METRIC_CACHE[key] = glass_metrics(kind, u)
    return _METRIC_CACHE[key]


def draw_glow(cr, kind, u, rgb, v):
    if v <= 0.01:
        return
    cy, rad = metrics(kind, u)
    R = rad * 4.4
    g = cairo.RadialGradient(0, cy, 0, 0, cy, R)
    g.add_color_stop_rgba(0.0, rgb[0], rgb[1], rgb[2], 0.55 * v)
    g.add_color_stop_rgba(0.22, rgb[0], rgb[1], rgb[2], 0.30 * v)
    g.add_color_stop_rgba(0.55, rgb[0], rgb[1], rgb[2], 0.08 * v)
    g.add_color_stop_rgba(1.0, rgb[0], rgb[1], rgb[2], 0.0)
    cr.save()
    cr.set_operator(cairo.OPERATOR_ADD)
    cr.set_source(g)
    cr.arc(0, cy, R, 0, 2 * math.pi)
    cr.fill()
    cr.restore()


def _rounded_rect(cr, x, y, w, h, r):
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def draw_socket(cr, kind, u):
    sw, sh = SOCKETS[kind]
    sw, sh = sw * u, sh * u
    g = cairo.LinearGradient(-sw, 0, sw, 0)
    g.add_color_stop_rgb(0.0, 0.07, 0.25, 0.13)
    g.add_color_stop_rgb(0.35, 0.30, 0.62, 0.38)
    g.add_color_stop_rgb(0.65, 0.16, 0.44, 0.24)
    g.add_color_stop_rgb(1.0, 0.05, 0.20, 0.10)
    _rounded_rect(cr, -sw, -0.02 * u, 2 * sw, sh, 0.07 * u)
    cr.set_source(g)
    cr.fill()
    cr.set_source_rgba(0, 0, 0, 0.35)
    cr.set_line_width(max(0.6, 0.035 * u))
    for f in (0.35, 0.62):
        cr.move_to(-sw + 0.02 * u, sh * f)
        cr.line_to(sw - 0.02 * u, sh * f)
    cr.stroke()
    return sh


def draw_bulb(cr, kind, u, rgb, v, dead=None):
    sh = draw_socket(cr, kind, u)
    dim = tuple(c * 0.28 + 0.03 for c in rgb)

    if dead == "broken":
        # Vidrio roto: solo queda un pedazo junto al casquillo, y se ve el filamento
        cr.save()
        glass_path(cr, kind, u)
        cr.clip()
        cr.new_path()
        y0 = sh + 0.10 * u
        pts = [(-u, 0), (u, 0), (u, y0 + 0.10 * u), (0.30 * u, y0 + 0.28 * u), (0.12 * u, y0 + 0.08 * u),
               (-0.02 * u, y0 + 0.34 * u), (-0.16 * u, y0 + 0.12 * u), (-0.30 * u, y0 + 0.26 * u), (-u, y0 + 0.05 * u)]
        cr.move_to(*pts[0])
        for p in pts[1:]:
            cr.line_to(*p)
        cr.close_path()
        cr.clip()
        glass_path(cr, kind, u)
        cr.set_source_rgba(dim[0], dim[1], dim[2], 0.85)
        cr.fill_preserve()
        cr.set_source_rgba(1, 1, 1, 0.18)
        cr.set_line_width(max(0.5, 0.03 * u))
        cr.stroke()
        cr.restore()
        cr.set_source_rgba(0.65, 0.62, 0.55, 0.9)
        cr.set_line_width(max(0.6, 0.03 * u))
        cr.move_to(-0.05 * u, sh)
        cr.curve_to(-0.07 * u, sh + 0.2 * u, -0.04 * u, sh + 0.35 * u, -0.06 * u, sh + 0.5 * u)
        cr.move_to(0.05 * u, sh)
        cr.curve_to(0.07 * u, sh + 0.2 * u, 0.05 * u, sh + 0.33 * u, 0.07 * u, sh + 0.46 * u)
        cr.stroke()
        return

    if dead == "burnt":
        base = mix(rgb, (0.32, 0.30, 0.28), 0.55)
        dim = tuple(c * 0.40 for c in base)
        v = 0.0

    cy, rad = glass_path(cr, kind, u)
    g = cairo.RadialGradient(-0.10 * u, cy - 0.30 * u, 0.02 * u, 0, cy, rad * 1.45)
    mid = mix(dim, rgb, v)
    core = mix(mid, (1, 1, 1), 0.72 * v)
    edge = mix(tuple(c * 0.55 for c in dim), tuple(c * 0.78 for c in rgb), v)
    g.add_color_stop_rgba(0.0, core[0], core[1], core[2], 0.97)
    g.add_color_stop_rgba(0.55, mid[0], mid[1], mid[2], 0.95)
    g.add_color_stop_rgba(1.0, edge[0], edge[1], edge[2], 0.95)
    cr.set_source(g)
    cr.fill_preserve()
    cr.set_source_rgba(0, 0, 0, 0.28)
    cr.set_line_width(max(0.5, 0.04 * u))
    cr.stroke()

    if v > 0.05:  # filamento caliente
        f = cairo.RadialGradient(0, cy - 0.05 * u, 0, 0, cy - 0.05 * u, 0.22 * u)
        f.add_color_stop_rgba(0, 1, 1, 0.95, 0.65 * v)
        f.add_color_stop_rgba(1, 1, 1, 0.95, 0)
        cr.save()
        cr.set_operator(cairo.OPERATOR_ADD)
        cr.set_source(f)
        cr.arc(0, cy - 0.05 * u, 0.22 * u, 0, 2 * math.pi)
        cr.fill()
        cr.restore()

    # reflejo
    cr.save()
    cr.translate(-0.13 * u if kind != "estrella" else -0.08 * u, cy - 0.20 * u)
    cr.rotate(0.18)
    cr.scale(1, 2.4 if kind in ("c9", "mini") else 1.4)
    cr.arc(0, 0, 0.06 * u, 0, 2 * math.pi)
    cr.set_source_rgba(1, 1, 1, 0.22 + 0.28 * v)
    cr.fill()
    cr.restore()

    if dead == "burnt":  # hollín
        s = cairo.RadialGradient(0, sh + 0.12 * u, 0, 0, sh + 0.12 * u, 0.32 * u)
        s.add_color_stop_rgba(0, 0, 0, 0, 0.55)
        s.add_color_stop_rgba(1, 0, 0, 0, 0)
        cr.save()
        glass_path(cr, kind, u)
        cr.clip()
        cr.set_source(s)
        cr.paint()
        cr.restore()


# --------------------------------------------------------------------------
# La tira de luces (se usa en las ventanas sobre el escritorio y en la vista previa)
# --------------------------------------------------------------------------

class Bulb:
    __slots__ = ("x", "i", "angle", "dead", "flasher", "phase", "v", "target")

    def __init__(self, x, i, angle, dead, flasher, phase):
        self.x, self.i, self.angle, self.dead = x, i, angle, dead
        self.flasher, self.phase = flasher, phase
        self.v, self.target = 0.0, 0.0


SPRITE_LEVELS = 33  # niveles de brillo prerrenderizados (0 = apagado)


class BulbSprites:
    """Cada bombillo se dibuja una sola vez por color y nivel de brillo; luego solo se copia.

    Dibujar desde cero 40-80 bombillos con degradados en cada cuadro tardaba tanto que
    se perdían cuadros (y la nieve daba tirones al ritmo del parpadeo).
    """

    def __init__(self):
        self.cache = {}

    def _surface(self, w, h, sf):
        s = cairo.ImageSurface(cairo.FORMAT_ARGB32, max(1, int(math.ceil(w * sf))), max(1, int(math.ceil(h * sf))))
        s.set_device_scale(sf, sf)
        return s

    def _store(self, key, val):
        if len(self.cache) > 4000:
            self.cache.clear()
        self.cache[key] = val
        return val

    def glow(self, kind, u, rgb, level, sf):
        key = ("g", kind, round(u, 2), rgb, level, sf)
        hit = self.cache.get(key)
        if hit:
            return hit
        cy, rad = metrics(kind, u)
        R = rad * 4.4
        size = 2 * R + 4
        surf = self._surface(size, size, sf)
        cr = cairo.Context(surf)
        ox, oy = size / 2, size / 2 - cy
        cr.translate(ox, oy)
        draw_glow(cr, kind, u, rgb, level / (SPRITE_LEVELS - 1))
        surf.flush()
        return self._store(key, (surf, ox, oy))

    def body(self, kind, u, rgb, level, dead, sf):
        key = ("b", kind, round(u, 2), rgb, level, dead, sf)
        hit = self.cache.get(key)
        if hit:
            return hit
        w, h = 1.25 * u + 4, 1.9 * u + 4
        surf = self._surface(w, h, sf)
        cr = cairo.Context(surf)
        ox, oy = w / 2, 0.1 * u + 2
        cr.translate(ox, oy)
        draw_bulb(cr, kind, u, rgb, level / (SPRITE_LEVELS - 1), dead)
        surf.flush()
        return self._store(key, (surf, ox, oy))


SPRITES = BulbSprites()


class LightsStrip(Gtk.DrawingArea):
    def __init__(self, get_cfg, preview=False):
        super().__init__()
        self.get_cfg = get_cfg
        self.preview = preview
        self.bulbs = []
        self.layout_sig = None
        self.spacing = 40.0
        self.step = None
        self.last_t = None
        self.now = 0.0
        self.force = True
        self.connect("draw", self.on_draw)
        self.tick_id = self.add_tick_callback(self.on_tick)
        self.sleep_id = 0

    # ---- dormir entre parpadeos
    def wake(self, force=False):
        """Vuelve a animar (p. ej. tras cambiar una opción)."""
        if force:
            self.force = True
        if self.sleep_id:
            GLib.source_remove(self.sleep_id)
            self.sleep_id = 0
        if self.tick_id is None:
            self.last_t = None
            self.tick_id = self.add_tick_callback(self.on_tick)

    def _sleep(self, seconds):
        """Nada se mueve: soltar el reloj de cuadros hasta el próximo parpadeo."""
        self.tick_id = None

        def again():
            self.sleep_id = 0
            self.wake()
            return False
        self.sleep_id = GLib.timeout_add(max(15, int(seconds * 1000)), again)

    def _queue_spans(self, changed, cfg, w, h):
        """Pide repintar solo las franjas de los bombillos que cambiaron (y sus vecinos)."""
        u = BULB_UNIT * cfg["size"]
        R = 1.9 * u + 4
        spans = []
        for b in sorted(changed, key=lambda b: b.x):
            x0, x1 = max(0.0, b.x - R), min(float(w), b.x + R)
            if spans and x0 <= spans[-1][1] + 2 * R:
                spans[-1][1] = max(spans[-1][1], x1)
            else:
                spans.append([x0, x1])
        if sum(x1 - x0 + 2 * R for x0, x1 in spans) > 0.5 * w:
            self.queue_draw()  # cambió casi toda la tira
            return
        for x0, x1 in spans:
            x0 = int(math.floor(x0))
            self.queue_draw_area(x0, 0, int(math.ceil(x1)) - x0, h)

    # ---- distribución
    def ensure_layout(self, width, cfg):
        sig = (int(width), cfg["size"], cfg["more"], cfg["burnt"], cfg["broken"], cfg["seed"])
        if sig == self.layout_sig:
            return
        self.layout_sig = sig
        u = BULB_UNIT * cfg["size"]
        sp = u * (1.55 if cfg["more"] else 2.45)
        n = max(1, int(width // sp))
        self.spacing = width / n
        rng = random.Random(cfg["seed"])
        old = {b.i: b for b in self.bulbs}
        self.bulbs = []
        for i in range(n):
            r_dead = rng.random()
            rng.random()  # reservado (mantiene la secuencia estable)
            r_fl = rng.random()
            angle = math.radians(rng.uniform(-7, 7))
            dead = None
            if cfg["burnt"] and r_dead < 0.09:
                dead = "burnt"
            elif cfg["broken"] and 0.09 <= r_dead < 0.15:
                dead = "broken"
            b = Bulb((i + 0.5) * self.spacing, i, angle, dead, r_fl < 0.35, rng.uniform(0, 6.28))
            if i in old:
                b.v = old[i].v
            self.bulbs.append(b)
        self.step = None
        self.force = True

    # ---- animación
    def on_tick(self, widget, clock):
        t = clock.get_frame_time() / 1e6
        dt = 0.016 if self.last_t is None else max(0.0, min(0.1, t - self.last_t))
        self.last_t = t
        self.now = t
        cfg = self.get_cfg()
        w = self.get_allocated_width()
        if w <= 1:
            return True
        self.ensure_layout(w, cfg)

        mode = cfg["mode"]
        interval = rate_to_interval(cfg["rate"])
        on = cfg["power"]
        changed = self.force
        self.force = False

        if mode not in CONTINUOUS_MODES:
            s = int(t / interval)
            if s != self.step:
                self.step = s
                for b in self.bulbs:
                    i = b.i
                    if mode == "none":
                        tg = 1.0
                    elif mode == "random":
                        tg = 1.0 if hash01(s, i) < 0.55 else 0.0
                    elif mode == "all":
                        tg = 1.0 if s % 2 == 0 else 0.0
                    elif mode == "chase":
                        tg = 1.0 if (i - s) % 3 == 0 else 0.0
                    elif mode == "alternate":
                        tg = 1.0 if (i + s) % 2 == 0 else 0.0
                    else:  # some
                        tg = (1.0 if hash01(s, i) < 0.5 else 0.0) if b.flasher else 1.0
                    b.target = tg
        else:
            speed = 0.6 + cfg["rate"] * 5.0
            for b in self.bulbs:
                if mode == "wave":
                    b.target = 0.12 + 0.88 * (0.5 + 0.5 * math.sin(t * speed * 1.6 - b.i * 0.55))
                else:
                    b.target = 0.10 + 0.90 * (0.5 + 0.5 * math.sin(t * speed))

        k = 1.0 - math.exp(-dt / 0.075)
        Lv = SPRITE_LEVELS - 1
        moved = []      # bombillos cuyo brillo visible cambió
        fading = False  # alguno sigue en transición
        for b in self.bulbs:
            tg = b.target if (on and not b.dead) else 0.0
            if mode in CONTINUOUS_MODES and on:
                nv = tg
            elif cfg["smooth"] or not on:
                nv = b.v + (tg - b.v) * k
                if abs(nv - tg) < 0.004:
                    nv = tg
            else:
                nv = tg
            if nv != tg:
                fading = True
            if int(round(nv * Lv)) != int(round(b.v * Lv)):
                moved.append(b)
            b.v = nv

        animating = cfg["sway"] or cfg["palette"] == "arcoiris" or (mode in CONTINUOUS_MODES and on)
        if changed or animating or (self.preview and moved):
            self.queue_draw()
        elif moved:
            self._queue_spans(moved, cfg, w, self.get_allocated_height())
        if not animating and not fading and not moved and not changed:
            # todo quieto: dormir hasta el próximo parpadeo (o 1 s si no parpadea)
            if on and mode != "none":
                self._sleep(interval - (t % interval) + 0.002)
            else:
                self._sleep(1.0)
            return False
        return True

    def bulb_color(self, b, cfg, v=None):
        v = b.v if v is None else v
        name, cols = PALETTE_MAP.get(cfg["palette"], PALETTE_MAP["clasico"])
        if cols is None:
            hue = round(((self.now * 0.06 + b.i * 0.07) % 1.0) * 96) / 96  # tonos cuantizados (caché)
            rgb = hsv(hue, 0.85, 1.0)
        else:
            rgb = cols[b.i % len(cols)]
        if cfg.get("warm") and 0.01 < v < 0.98:
            # Como un incandescente: con poca corriente el filamento da luz ámbar
            w = (1.0 - v) ** 1.5 * 0.75 * min(1.0, v / 0.08)
            rgb = mix(rgb, mix(rgb, (1.0, 0.45, 0.12), 0.85), w)
        return tuple(round(c, 3) for c in rgb)

    # ---- dibujo
    def on_draw(self, widget, cr):
        cfg = self.get_cfg()
        w, h = self.get_allocated_width(), self.get_allocated_height()
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        if not self.bulbs:
            return False

        if self.preview:
            _rounded_rect(cr, 0, 0, w, h, 12)
            g = cairo.LinearGradient(0, 0, 0, h)
            g.add_color_stop_rgb(0, 0.035, 0.06, 0.11)
            g.add_color_stop_rgb(1, 0.07, 0.10, 0.17)
            cr.set_source(g)
            cr.fill_preserve()
            cr.clip()
            rng = random.Random(7)
            for _ in range(int(w / 9)):
                cr.set_source_rgba(1, 1, 1, rng.uniform(0.15, 0.5))
                cr.arc(rng.uniform(0, w), rng.uniform(h * 0.45, h), rng.uniform(0.4, 1.1), 0, 6.3)
                cr.fill()
            cr.translate(0, 6)
        elif cfg["position"] == "bottom":
            cr.translate(0, h)
            cr.scale(1, -1)

        u = BULB_UNIT * cfg["size"]
        sag = 0.45 * u
        top = TOP_MARGIN
        sp = self.spacing
        # GTK ya recortó el dibujo a la franja que cambió: solo se dibuja lo que cae en ella
        R = 1.9 * u + 4
        cx0, _cy0, cx1, _cy1 = cr.clip_extents()

        # cable
        n = len(self.bulbs)
        k0 = max(0, int(cx0 // sp) - 1)
        k1 = min(n, int(cx1 // sp) + 2)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.move_to(k0 * sp, top)
        for k in range(k0, k1):
            x0, x1 = k * sp, (k + 1) * sp
            cx, cy = (x0 + x1) / 2, top + 2 * sag
            cr.curve_to(x0 + 2 / 3 * (cx - x0), top + 2 / 3 * (cy - top),
                        x1 + 2 / 3 * (cx - x1), top + 2 / 3 * (cy - top), x1, top)
        path = cr.copy_path()
        cr.set_source_rgba(0.04, 0.16, 0.08, 0.95)
        cr.set_line_width(max(1.6, 0.13 * u))
        cr.stroke()
        cr.append_path(path)
        cr.set_source_rgba(0.35, 0.65, 0.40, 0.55)
        cr.set_line_width(max(0.6, 0.04 * u))
        cr.stroke()

        kind = cfg["bulb"]
        t = self.now

        def place(b):
            cr.translate(b.x, top + sag)
            a = b.angle
            if cfg["sway"]:
                a += math.radians(5) * math.sin(t * 1.4 + b.phase)
            cr.rotate(a)

        sf = self.get_scale_factor()
        L = SPRITE_LEVELS - 1
        items = []
        for b in self.bulbs:
            if b.x < cx0 - R or b.x > cx1 + R:
                continue
            level = 0 if b.dead else int(round(b.v * L))
            items.append((b, level, self.bulb_color(b, cfg, level / L)))
        cr.set_operator(cairo.OPERATOR_ADD)  # 1ª pasada: resplandor (se suma entre vecinos)
        for b, level, rgb in items:
            if level > 0:
                surf, ox, oy = SPRITES.glow(kind, u, rgb, level, sf)
                cr.save()
                place(b)
                cr.set_source_surface(surf, -ox, -oy)
                cr.paint()
                cr.restore()
        cr.set_operator(cairo.OPERATOR_OVER)  # 2ª pasada: bombillos
        for b, level, rgb in items:
            surf, ox, oy = SPRITES.body(kind, u, rgb, level, b.dead, sf)
            cr.save()
            place(b)
            cr.set_source_surface(surf, -ox, -oy)
            cr.paint()
            cr.restore()
        return False


