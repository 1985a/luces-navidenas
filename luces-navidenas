    # ---------- ayudantes de construcción
    def card(self, title, hint=None):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.get_style_context().add_class("card")
        lbl = Gtk.Label(label=title, xalign=0)
        lbl.get_style_context().add_class("card-title")
        box.pack_start(lbl, False, False, 0)
        if hint:
            h = Gtk.Label(label=hint, xalign=0)
            h.set_line_wrap(True)
            h.get_style_context().add_class("hint")
            box.pack_start(h, False, False, 0)
        return box

    def set(self, key, value):
        if self.updating:
            return
        new = copy.deepcopy(self.app.cfg)
        new[key] = value
        self.app.apply(new, save=False)
        self.update_apply()

    def switch_row(self, key, label, tooltip=None):
        row = Gtk.Box(spacing=10)
        lbl = Gtk.Label(label=label, xalign=0)
        lbl.set_line_wrap(True)
        sw = Gtk.Switch()
        sw.set_valign(Gtk.Align.CENTER)
        sw.connect("notify::active", lambda s, _p: self.set(key, s.get_active()))
        row.pack_start(lbl, True, True, 0)
        row.pack_end(sw, False, False, 0)
        if tooltip:
            row.set_tooltip_text(tooltip)
        self.refreshers.append(lambda c: sw.set_active(bool(c[key])))
        return row, sw

    def combo_row(self, key, label, items):
        row = Gtk.Box(spacing=10)
        row.pack_start(Gtk.Label(label=label, xalign=0), False, False, 0)
        cb = Gtk.ComboBoxText()
        for k, n in items:
            cb.append(k, n)
        cb.connect("changed", lambda c: c.get_active_id() and self.set(key, c.get_active_id()))
        row.pack_end(cb, False, False, 0)
        self.refreshers.append(lambda c: cb.set_active_id(c[key]))
        return row

    def volume_row(self, key, tooltip):
        row = Gtk.Box(spacing=8)
        row.set_tooltip_text(tooltip)
        icon = Gtk.Image()
        sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 1, 0.01)
        sc.set_draw_value(False)
        pct = Gtk.Label(xalign=1)
        pct.set_width_chars(4)
        pct.get_style_context().add_class("hint")

        def show(v):
            pct.set_text(f"{round(v * 100)}%")
            name = ("audio-volume-muted-symbolic" if v < 0.01 else "audio-volume-low-symbolic" if v < 0.34
                    else "audio-volume-medium-symbolic" if v < 0.67 else "audio-volume-high-symbolic")
            icon.set_from_icon_name(name, Gtk.IconSize.BUTTON)

        def changed(s):
            v = round(s.get_value(), 2)
            show(v)
            self.set(key, v)
        sc.connect("value-changed", changed)
        self.refreshers.append(lambda c: (sc.set_value(c[key]), show(c[key])))
        row.pack_start(icon, False, False, 0)
        row.pack_start(sc, True, True, 0)
        row.pack_end(pct, False, False, 0)
        return row

    def scale_row(self, key, lo, hi, marks):
        sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, (hi - lo) / 100.0)
        sc.set_draw_value(False)
