    return True


def make_click_through(win):
    def apply(*_):
        win.input_shape_combine_region(cairo.Region())
    win.connect("realize", apply)


def prepare_overlay_window(win, monitor, height=None, bottom=False, reserve=0, namespace="luces-navidenas"):
    """height=None -> pantalla completa (efectos); si no, una tira arriba o abajo."""
    win.set_app_paintable(True)
    win.set_decorated(False)
    win.set_accept_focus(False)
    screen = win.get_screen()
    visual = screen.get_rgba_visual()
    if visual is not None:
        win.set_visual(visual)
    GtkLayerShell.init_for_window(win)
    GtkLayerShell.set_namespace(win, namespace)
    GtkLayerShell.set_layer(win, GtkLayerShell.Layer.TOP)
    GtkLayerShell.set_monitor(win, monitor)
    E = GtkLayerShell.Edge
    anchors = [E.LEFT, E.RIGHT, E.TOP, E.BOTTOM] if not height else \
        [E.LEFT, E.RIGHT, E.BOTTOM if bottom else E.TOP]
    for edge in anchors:
        GtkLayerShell.set_anchor(win, edge, True)
    # reserve > 0: las ventanas se acomodan debajo de las luces (como una barra)
    GtkLayerShell.set_exclusive_zone(win, reserve)
    if hasattr(GtkLayerShell, "set_keyboard_mode"):
        GtkLayerShell.set_keyboard_mode(win, GtkLayerShell.KeyboardMode.NONE)
    else:
        GtkLayerShell.set_keyboard_interactivity(win, False)
    if height:
        win.set_size_request(-1, height)
    make_click_through(win)


