class MusicPlayer:
    """Reproduce la lista en bucle: decodificador → volumen (en Python) → PipeWire."""

    CHUNK_FRAMES = 2048  # ≈ 46 ms a 44,1 kHz: el volumen responde casi al instante

    def __init__(self):
        self.thread = None
        self.stop_ev = threading.Event()
        self.procs = []
        self.tracks = []
        self.status = ""
        self.volume = 0.7

    def set_volume(self, vol):
        self.volume = max(0.0, min(1.0, vol))

    def set_tracks(self, tracks):
        if tracks != self.tracks:
            self.tracks = list(tracks)
            if self.running():
                self.stop()
                self.start()

    def running(self):
        return self.thread is not None and self.thread.is_alive()

    def start(self):
        if self.running() or not self.tracks:
            return
        self.stop_ev.clear()
        self.thread = threading.Thread(target=self._loop, daemon=True)
        self.thread.start()

    def _kill(self):
        for p in self.procs:
            if p.poll() is None:
                try:
                    p.kill()
                except OSError:
                    pass
        self.procs = []

    def stop(self):
        self.stop_ev.set()
        self._kill()
        if self.thread:
            self.thread.join(timeout=2)
        self.thread = None

    # ---- fuentes de audio
    def _source(self, path):
        """Generador de (bytes_pcm, tasa, canales) o None si no se puede decodificar."""
        if path.lower().endswith(".wav"):
            try:
                w = wave.open(path, "rb")
                if w.getsampwidth() == 2:
                    rate, ch = w.getframerate(), w.getnchannels()

                    def gen():
                        with w:
                            while not self.stop_ev.is_set():
                                data = w.readframes(self.CHUNK_FRAMES)
                                if not data:
                                    return
                                yield data
                    return gen(), rate, ch
                w.close()
            except (OSError, wave.Error, EOFError):
                pass
        dec = decoder_for(path)
        if not dec:
            return None
        cmd, rate, ch = dec
        try:
            p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                 stdin=subprocess.DEVNULL, start_new_session=True, env=AUDIO_ENV)
        except OSError:
            return None
        self.procs.append(p)
        size = self.CHUNK_FRAMES * ch * 2

        def gen():
            while not self.stop_ev.is_set():
                data = p.stdout.read(size)
                if not data:
                    return
                yield data
        return gen(), rate, ch

    def _scale(self, data, gain):
        if gain >= 0.999:
            return data
        if len(data) % 2:
            data = data[:-1]
        a = array.array("h")
        a.frombytes(data)
        if sys.byteorder != "little":
            a.byteswap()
        if gain <= 0.001:
            return bytes(len(data))
        a = array.array("h", [int(x * gain) for x in a])
        if sys.byteorder != "little":
            a.byteswap()
        return a.tobytes()

    def _play(self, path):
        src = self._source(path)
        if not src:
            return False
        chunks, rate, ch = src
        out_cmd = raw_output_for(rate, ch)
        if not out_cmd:
            self.status = "Falta pw-cat (paquete pipewire) para reproducir audio."
            return False
        try:
            out = subprocess.Popen(out_cmd, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL, start_new_session=True, env=AUDIO_ENV)
        except OSError:
            return False
        self.procs.append(out)
        gain = self.volume ** 2  # curva perceptual: el deslizador se siente más parejo
        bps = float(rate * ch * 2)
        written = 0
        t0 = time.monotonic()
        try:
            for data in chunks:
                # Enviar al ritmo real (máx. 0,2 s adelantado) para que el volumen responda al momento
                ahead = written / bps - (time.monotonic() - t0)
                if ahead > 0.2:
                    if self.stop_ev.wait(ahead - 0.2):
                        break
                target = self.volume ** 2
                gain += (target - gain) * 0.5  # suaviza saltos bruscos
                out.stdin.write(self._scale(data, gain))
                out.stdin.flush()
                written += len(data)
        except (BrokenPipeError, OSError, ValueError):
            pass
        try:
            out.stdin.close()
        except OSError:
            pass
        while out.poll() is None and not self.stop_ev.is_set():
            time.sleep(0.1)
        self._kill()
        return True

    def _loop(self):
        while not self.stop_ev.is_set():
            played = False
            for path in list(self.tracks):
                if self.stop_ev.is_set():
                    return
                real = os.path.join(CACHE_DIR, "jingle-bells.wav") if path == BUILTIN_SONG else path
                if self._play(real):
                    played = True
                    self.stop_ev.wait(0.8)
            if not played:
                if not self.status:
                    self.status = "No hay forma de reproducir estas canciones."
                return


