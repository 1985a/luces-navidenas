    def draw_swatch(self, da, cr, key):
        w, h = da.get_allocated_width(), da.get_allocated_height()
        cols = PALETTE_MAP[key][1]
        n = 5
        for i in range(n):
            rgb = cols[i % len(cols)] if cols else hsv(i / n, 0.85, 1.0)
            x = w / 2 + (i - (n - 1) / 2) * 12
            g = cairo.RadialGradient(x - 1.5, h / 2 - 1.5, 0, x, h / 2, 6)
            g.add_color_stop_rgb(0, *mix(rgb, (1, 1, 1), 0.6))
            g.add_color_stop_rgb(1, *rgb)
            cr.set_source(g)
            cr.arc(x, h / 2, 5, 0, 6.3)
            cr.fill()
        return False

