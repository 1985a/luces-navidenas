    def refresh_songs(self, c):
        for ch in self.song_list.get_children():
            self.song_list.remove(ch)
        skip = set(c.get("music_skip", []))
        for path, title in list_songs(c["music_dir"]):
            cb = Gtk.CheckButton(label=title)
            cb.set_active(path not in skip)
            cb.connect("toggled", self.on_song_toggled, path)
            self.song_list.add(cb)
        self.song_list.show_all()
        self.folder_lbl.set_text(c["music_dir"].replace(os.path.expanduser("~"), "~", 1))
        self.folder_lbl.set_tooltip_text(c["music_dir"])
        midi = shutil.which("timidity") or (shutil.which("fluidsynth") and _soundfont())
        player = _which("ffmpeg", "mpv")
        notes = []
        if not midi:
            notes.append("Para MIDI instala timidity++ o fluidsynth.")
        if not player:
            notes.append("Para MP3/OGG instala ffmpeg o mpv.")
        if not _which("pw-cat", "pacat", "aplay"):
            notes.append("Falta pw-cat (paquete pipewire).")
        self.music_status.set_text(" ".join(notes))
        self.music_status.set_visible(bool(notes))

    def on_song_toggled(self, cb, path):
        if self.updating:
            return
        skip = set(self.app.cfg.get("music_skip", []))
        if cb.get_active():
            skip.discard(path)
        else:
            skip.add(path)
        self.set("music_skip", sorted(skip))

