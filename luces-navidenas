def _which(*names):
    for n in names:
        if shutil.which(n):
            return n
    return None


def wav_command(path, vol=1.0):
    p = _which("pw-play", "paplay", "ffplay", "mpv", "aplay")
    if p == "pw-play":
        return ["pw-play", f"--volume={vol:.3f}", path]
    if p == "paplay":
        return ["paplay", f"--volume={int(vol * 65536)}", path]
    if p == "ffplay":
        return ["ffplay", "-nodisp", "-autoexit", "-loglevel", "quiet", "-volume", str(int(vol * 100)), path]
    if p == "mpv":
        return ["mpv", "--no-video", "--really-quiet", f"--volume={int(vol * 100)}", path]
    if p == "aplay":
        return ["aplay", "-q", path]
    return None


def _soundfont():
    for p in ("/usr/share/soundfonts/default.sf2", "/usr/share/soundfonts/FluidR3_GM.sf2",
              "/usr/share/sounds/sf2/FluidR3_GM.sf2", "/usr/share/soundfonts/freepats-general-midi.sf2"):
        if os.path.exists(p):
            return p
    return None


def decoder_for(path):
    """Devuelve (comando, tasa, canales) que decodifica a PCM s16le por stdout, o None.

    Con el audio crudo en nuestras manos, el volumen se aplica aquí mismo y cambia al instante.
    """
    ext = os.path.splitext(path)[1].lower()
    R = 44100
    if ext in (".mid", ".midi", ".kar"):
        if shutil.which("timidity"):
            return ["timidity", "-idqq", "-Or1sl", "-s", str(R), "-o", "-", path], R, 2
        sf = _soundfont()
        if shutil.which("fluidsynth") and sf:
            return ["fluidsynth", "-ni", "-q", "-T", "raw", "-O", "s16", "-r", str(R), "-F", "-", sf, path], R, 2
        return None
    if shutil.which("ffmpeg"):
        return ["ffmpeg", "-nostdin", "-loglevel", "quiet", "-i", path,
                "-f", "s16le", "-ac", "2", "-ar", str(R), "-"], R, 2
    if shutil.which("mpv"):
        return ["mpv", "--no-config", "--really-quiet", "--no-video", "--ao=pcm", "--ao-pcm-file=/dev/stdout",
                "--ao-pcm-waveheader=no", "--audio-format=s16", "--audio-channels=stereo",
                f"--audio-samplerate={R}", path], R, 2
    return None


def raw_output_for(rate, ch):
    """Reproductor que acepta PCM s16le crudo por stdin."""
    if shutil.which("pw-cat"):
        return ["pw-cat", "--playback", "--raw", "--format=s16", f"--rate={rate}", f"--channels={ch}",
                "--media-role=Music", "-P", '{"media.name": "Luces Navideñas", "application.name": "Luces Navideñas"}',
                "-"]
    if shutil.which("pacat"):
        return ["pacat", "--playback", "--raw", "--format=s16le", f"--rate={rate}", f"--channels={ch}",
                "--client-name=Luces Navideñas"]
    if shutil.which("aplay"):
        return ["aplay", "-q", "-t", "raw", "-f", "S16_LE", "-r", str(rate), "-c", str(ch), "-"]
    return None


