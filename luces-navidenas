        title = Gtk.Label(xalign=0)
        title.set_markup("<span size='large' weight='bold'>Luces Navideñas sigue funcionando\nen segundo plano</span>")
        head.pack_start(bulb, False, False, 0)
        head.pack_start(title, True, True, 0)
        body = Gtk.Label(xalign=0)
        body.set_line_wrap(True)
        body.set_max_width_chars(52)
        body.set_markup(
            "Las luces se quedan encendidas aunque cierres esta ventana.\n\n"
            "<b>Para volver a abrir las opciones:</b>\n"
            "  •  haz clic en el bombillo de la bandeja, o\n"
            "  •  vuelve a ejecutar <tt>luces-navidenas</tt> (lanzador o terminal).\n\n"
            "<b>Para cerrarlo del todo:</b> botón «Salir» o <tt>luces-navidenas --salir</tt>.")
        chk = Gtk.CheckButton(label="No volver a mostrar este aviso")
        area.pack_start(head, False, False, 0)
        area.pack_start(body, False, False, 0)
        area.pack_start(chk, False, False, 4)
        dlg.add_button("Salir del programa", 1)
        ok = dlg.add_button("Entendido", Gtk.ResponseType.OK)
        ok.get_style_context().add_class("suggested-action")
        dlg.set_default_response(Gtk.ResponseType.OK)
