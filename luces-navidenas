def render_icon_pixmap(rgb, v, size):
    """Bombillo como pixmap ARGB32 en orden de red (lo que pide StatusNotifierItem)."""
    surf = render_bulb_icon(rgb, v, size)
    data = bytes(surf.get_data())
    stride = surf.get_stride()
    out = bytearray()
    little = sys.byteorder == "little"
    for y in range(size):
        row = data[y * stride:y * stride + size * 4]
        for x in range(0, size * 4, 4):
            if little:
                b_, g_, r_, a_ = row[x], row[x + 1], row[x + 2], row[x + 3]
            else:
                a_, r_, g_, b_ = row[x], row[x + 1], row[x + 2], row[x + 3]
            if 0 < a_ < 255:  # quitar el alfa premultiplicado
                r_, g_, b_ = (min(255, c * 255 // a_) for c in (r_, g_, b_))
            out += bytes((a_, r_, g_, b_))
    return (size, size, bytes(out))


